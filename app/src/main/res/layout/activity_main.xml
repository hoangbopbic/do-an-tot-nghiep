<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Smart Home"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:backgroundTint="#E0E0E0">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_person"
                    android:padding="8dp"
                    app:tint="#757575"/>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <!-- Voice Control -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            android:backgroundTint="#E3F2FD"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <LinearLayout
                android:id="@+id/btnVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mic"
                    app:tint="#1976D2"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điều khiển bằng giọng nói"
                    android:layout_marginLeft="12dp"
                    android:textColor="#1976D2"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thiết bị"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <!-- Grid Layout for Devices -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins">
            <!-- Card Chế độ (Manual/Auto) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:backgroundTint="#FFF3E0"> <!-- Màu cam nhạt để phân biệt với thiết bị -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_motion"
                        app:tint="#FB8C00"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chế độ"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"/>
                    <Switch
                        android:id="@+id/swMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Manual"
                        android:textSize="12sp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Card Đèn Nhà -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_lightbulb"
                        app:tint="#FFD600"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đèn phòng"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"/>
                    <Switch
                        android:id="@+id/swLedNha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Cửa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_lock_outline"
                        app:tint="#4CAF50"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cửa chính"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"/>
                    <Switch
                        android:id="@+id/swDoor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Đèn Cửa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_lightbulb"
                        app:tint="#FFA000"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đèn cửa"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"/>
                    <Switch
                        android:id="@+id/swLedCua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Giàn Phơi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_cloud"
                        app:tint="#00BCD4"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giàn phơi"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"/>
                    <Switch
                        android:id="@+id/swRack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- Sensor Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông số môi trường"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            android:backgroundTint="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_cloud_rain" app:tint="#2196F3"/>
                    <TextView android:id="@+id/txtRain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tạnh ráo" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#666"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_fire" app:tint="#F44336"/>
                    <TextView android:id="@+id/txtFlame" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="An toàn" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#666"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_motion" app:tint="#4CAF50"/>
                    <TextView android:id="@+id/txtPIR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yên tĩnh" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#666"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Emergency Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllOff"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp"
            android:text="NGẮT TOÀN BỘ HỆ THỐNG"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            app:backgroundTint="#FFEBEE"
            app:cornerRadius="16dp"
            app:strokeColor="#FFCDD2"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>